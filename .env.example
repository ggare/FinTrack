# ============================================================
# FinTrack — пример файла окружения.
# Скопируйте в .env и при необходимости поправьте значения:
#   cp .env.example .env
# ============================================================

# Окружение: development | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Секрет для подписи JWT. Сгенерируйте свой: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-please-0123456789abcdef

# PostgreSQL (asyncpg-драйвер)
DATABASE_URL=postgresql+asyncpg://fintrack:fintrack@localhost:5432/fintrack

# Redis: брокер Celery, кэш курсов, rate limiting
REDIS_URL=redis://localhost:6379/0

# Время жизни JWT-токена (в минутах)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate limit на вход: N попыток за окно (секунд) с одного IP
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300

# Внешний API курсов валют (база USD)
EXCHANGE_API_URL=https://open.er-api.com/v6/latest/USD

# Разрешённые CORS-источники (JSON-список)
CORS_ORIGINS=["http://localhost:8000"]

# Раунды bcrypt (в тестах уменьшается через переменную окружения)
BCRYPT_ROUNDS=12
