# ============================================================
# FinTrack - example environment file.
# Copy it to .env and adjust the values if needed:
#   cp .env.example .env
# ============================================================

# Environment: development | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# JWT signing secret. Generate your own: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-please-0123456789abcdef

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://fintrack:fintrack@localhost:5432/fintrack

# Redis: Celery broker, exchange-rate cache, rate limiting
REDIS_URL=redis://localhost:6379/0

# JWT token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Login rate limit: N attempts per window (seconds) per IP
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300

# External exchange-rate API (USD base)
EXCHANGE_API_URL=https://open.er-api.com/v6/latest/USD

# Allowed CORS origins (JSON list)
CORS_ORIGINS=["http://localhost:8000"]

# bcrypt rounds (tests lower it via an env variable)
BCRYPT_ROUNDS=12
